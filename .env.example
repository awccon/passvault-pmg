# Copy this file to .env and fill in your own values.
# .env is gitignored — it will never be committed.

# Signs your login session cookie. Generate with: openssl rand -hex 32
# Keep this the same forever once set — changing it logs everyone out.
SESSION_SECRET=

# Required for anyone to be able to register a new account. Pick any
# string you want, then share it only with people you want to have
# access. Leave this blank/unset to disable registration entirely.
REGISTRATION_CODE=

# Set to true only once this app is served over HTTPS (e.g. behind
# Caddy/nginx with TLS). Leave unset for local http://localhost testing.
# COOKIE_SECURE=true
